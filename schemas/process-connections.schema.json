{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petro.local/schemas/process-connections.schema.json",
  "title": "工艺连接教学数据（process connections）",
  "description": "唯一连接数据源。Blender 实体管线、前端教学线、粒子动画、总览路径均从此文件读取；任何一端的坐标副本都视为违约。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "coordinateSpace", "connections"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generatedFrom": {
      "type": "string",
      "minLength": 1,
      "description": "本文件的产出方式说明；手工维护时写人工依据。"
    },
    "coordinateSpace": { "$ref": "#/$defs/coordinateSpace" },
    "connections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/connection" }
    }
  },
  "$defs": {
    "coordinateSpace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinateSpaceId", "unit", "upAxis", "handedness", "rootObjectId"],
      "properties": {
        "coordinateSpaceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(/[A-Za-z][A-Za-z0-9_]*)?$",
          "description": "必须与 tower.manifest.json 的 coordinateSpace.coordinateSpaceId 完全一致（当前为 distillation_unit_asset_local，即 assetLocal Y-up 米制）。禁止裸 XYZ 或未声明坐标空间；一致性由 validate:connections 强制。"
        },
        "unit": { "const": "meter" },
        "upAxis": { "const": "+Y" },
        "handedness": { "const": "right" },
        "rootObjectId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "description": "assetLocal 的原点对象，与 Manifest 的 assetId 对应。"
        },
        "notes": { "type": "string" }
      }
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectId", "anchorId"],
      "properties": {
        "objectId": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
        "anchorId": { "type": "string", "pattern": "^anchor_[a-z0-9_]{2,63}$" }
      },
      "description": "端点只声明 objectId + anchorId；坐标一律从 Manifest/GLB 的 anchor 节点变换取得，不在此重复保存。"
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basisId", "version", "sourceTitle", "sourceOrg", "sourceUrlOrDoc",
        "sourceSection", "scope", "limitations", "reviewStatus", "reviewedBy", "reviewedAt"
      ],
      "properties": {
        "basisId": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "sourceTitle": { "type": "string", "minLength": 1, "maxLength": 200 },
        "sourceOrg": { "type": "string", "minLength": 1, "maxLength": 120 },
        "sourceUrlOrDoc": { "type": "string", "minLength": 1, "maxLength": 300 },
        "sourceSection": { "type": "string", "minLength": 1, "maxLength": 200 },
        "scope": { "type": "string", "minLength": 1, "maxLength": 300 },
        "limitations": {
          "type": "array",
          "minItems": 0,
          "items": { "type": "string", "minLength": 1 }
        },
        "reviewStatus": {
          "type": "string",
          "enum": ["approved", "reviewed", "draft", "rejected", "pendingBasis"]
        },
        "reviewedBy": { "type": ["string", "null"] },
        "reviewedAt": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[0-9:.Z+-]+)?$" }
          ]
        },
        "pendingBasis": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "reviewStatus": { "enum": ["approved", "reviewed"] } }, "required": ["reviewStatus"] },
          "then": {
            "required": ["reviewedBy", "reviewedAt"],
            "properties": {
              "reviewedBy": { "type": "string", "minLength": 1 },
              "reviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[0-9:.Z+-]+)?$" }
            }
          }
        },
        {
          "if": { "properties": { "reviewStatus": { "const": "approved" } }, "required": ["reviewStatus"] },
          "then": { "properties": { "pendingBasis": { "const": false } } }
        }
      ]
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overview", "detail", "particles"],
      "properties": {
        "overview": { "type": "boolean" },
        "detail": { "type": "boolean" },
        "particles": { "type": "boolean" },
        "displayOffset": {
          "$ref": "#/$defs/vec3",
          "description": "教学观察用的整体偏移（assetLocal，米）。拓扑、起终点与物流含义不得改变；只用于让路线偏离实体管线以便观察。"
        },
        "particleCount": { "type": "integer", "minimum": 1, "maximum": 400 },
        "particleSpeed": { "type": "number", "exclusiveMinimum": 0, "maximum": 5 },
        "particleSize": { "type": "number", "exclusiveMinimum": 0, "maximum": 2 },
        "lineRadius": { "type": "number", "exclusiveMinimum": 0, "maximum": 2 }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connectionId", "from", "to", "coordinateSpaceId", "waypoints",
        "medium", "phase", "direction", "displayColorToken", "display",
        "teachingSimplification", "basis"
      ],
      "properties": {
        "connectionId": { "type": "string", "pattern": "^conn_[a-z0-9_]{2,60}$" },
        "from": { "$ref": "#/$defs/endpoint" },
        "to": { "$ref": "#/$defs/endpoint" },
        "coordinateSpaceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(/[A-Za-z][A-Za-z0-9_]*)?$",
          "description": "必须与顶层 coordinateSpace.coordinateSpaceId、以及 Manifest 的坐标空间完全一致。"
        },
        "waypoints": {
          "type": "array",
          "minItems": 0,
          "items": { "$ref": "#/$defs/vec3" },
          "description": "只存中间控制点，不得重复保存端点坐标。"
        },
        "medium": { "type": "string", "minLength": 1, "maxLength": 80 },
        "phase": { "type": "string", "enum": ["vapor", "liquid", "mixed", "solid"] },
        "direction": { "type": "string", "enum": ["forward", "reverse", "bidirectional"] },
        "displayColorToken": { "type": "string", "pattern": "^--[a-z0-9-]+$" },
        "display": { "$ref": "#/$defs/display" },
        "teachingSimplification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "description": "相较于真实工艺做了哪些简化，必须在 UI 上可追溯。"
        },
        "basis": { "$ref": "#/$defs/basis" },
        "geometryRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "可选：实体管线对象名前缀，用于从 GLB/Manifest 反查该连接生成的几何。"
        }
      }
    }
  }
}

