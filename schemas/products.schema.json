{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petro-chain.local/schemas/products.schema.json",
  "title": "L5 产品去向数据契约",
  "type": "object",
  "required": ["schemaVersion", "items"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "generatedFrom": { "type": "string" },
    "note": { "type": "string" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "productId",
        "displayName",
        "productCategory",
        "representationType",
        "typicalFeedstocks",
        "petroleumRouteDescription",
        "teachingNote",
        "modelAssetId",
        "modelNodeUid",
        "inTask"
      ],
      "additionalProperties": false,
      "properties": {
        "productId": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,47}$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 24 },
        "productCategory": {
          "type": "string",
          "enum": [
            "fuel",
            "material",
            "polymer",
            "fiber",
            "elastomer",
            "inorganic_material",
            "natural_fiber",
            "mineral"
          ]
        },
        "representationType": {
          "type": "string",
          "enum": ["product", "material", "manufacturedItem", "applicationScene"]
        },
        "typicalFeedstocks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["petroleum", "natural_gas", "coal", "biomass", "other"] }
        },
        "petroleumRouteDescription": { "type": "string", "minLength": 8 },
        "teachingNote": { "type": "string", "minLength": 8 },
        "modelAssetId": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
        "modelNodeUid": { "type": "string", "minLength": 1 },
        "inTask": { "type": "boolean" }
      }
    }
  }
}
